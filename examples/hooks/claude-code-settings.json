{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "http",
            "url": "https://<INSTALLATION_ID>.webtrigger.atlassian.app/<PATH>/gate",
            "timeout": 10,
            "onFailure": "block",
            "headers": {
              "Authorization": "Bearer $PERMIS_AGENT_TOKEN",
              "X-Permis-Issue": "$PERMIS_AGENT_ISSUE"
            },
            "allowedEnvVars": [
              "PERMIS_AGENT_TOKEN",
              "PERMIS_AGENT_ISSUE"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "http",
            "url": "https://<INSTALLATION_ID>.webtrigger.atlassian.app/<PATH>/gate",
            "timeout": 10,
            "onFailure": "block",
            "headers": {
              "Authorization": "Bearer $PERMIS_AGENT_TOKEN",
              "X-Permis-Issue": "$PERMIS_AGENT_ISSUE"
            },
            "allowedEnvVars": [
              "PERMIS_AGENT_TOKEN",
              "PERMIS_AGENT_ISSUE"
            ]
          }
        ]
      }
    ]
  }
}
